---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Phone, ArrowRight } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
import { photo } from '../lib/photos';
import { general, em } from '../lib/continut';

interface Props {
  image?: ImageMetadata;
  title?: string;
  text?: string;
}

const c = general.chemareFinala;
const { image = photo(c.poza), title = em(c.titlu, 'text-brass-300'), text = c.text } = Astro.props;
---

<section class="relative overflow-hidden bg-forest-900 text-white">
  <div class="absolute inset-x-0 -top-[15%] h-[130%]" data-parallax="10">
    <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="img-cover" />
  </div>
  <div class="absolute inset-0 bg-forest-950/65"></div>
  <div class="container-x relative flex min-h-[80svh] flex-col items-center justify-center py-32 text-center">
    <p class="eyebrow eyebrow-light justify-center" data-reveal>{c.eticheta}</p>
    <h2 class="display-lg mt-7 max-w-4xl" data-split set:html={title} />
    <p class="mt-8 max-w-xl text-lg text-white/80" data-reveal>{text}</p>
    <div class="mt-12 flex flex-col items-center gap-4 sm:flex-row" data-reveal>
      <a href={site.phoneHref} class="btn btn-brass">
        <Phone size={15} /> Rezervă telefonic
      </a>
      <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-ghost-light">
        <WhatsAppIcon size={16} /> WhatsApp
      </a>
      <a href={url('/galerie')} class="btn btn-ghost-light">
        Vezi cum arată pensiunea <ArrowRight size={15} />
      </a>
    </div>
  </div>
</section>
