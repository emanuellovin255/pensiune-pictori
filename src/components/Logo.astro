---
import { url } from '../lib/url';
import { general, em } from '../lib/continut';

const word = em(general.numeScurt.replace(/^(\S+)\s+(.+)$/, '$1 *$2*'));

interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;
---

<a href={url('/')} class:list={['group inline-flex items-center gap-3', className]} aria-label={`${general.numeScurt} – pagina principală`}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 shrink-0 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:rotate-[-10deg]" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-opacity="0.45" />
    <path
      d="M20 10.5c-6 0-10 4-10 8.7 0 4.5 3.6 7.6 6.9 7.6 1.8 0 2-1.3 1.4-2.4-.6-1.3.1-2.4 1.6-2.4h2.4c3.9 0 6.7-2.3 6.7-5.5 0-3.5-3.9-6-9-6Z"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
    <circle cx="15.3" cy="18.2" r="1.45" fill="var(--color-brass-400)" />
    <circle cx="18.7" cy="14.4" r="1.45" fill="var(--color-clay-500)" />
    <circle cx="23.4" cy="14.5" r="1.45" fill="var(--color-river-300)" />
    <path d="M31.5 21.5 24.3 28.7" stroke="var(--color-brass-400)" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="logo-word font-serif text-[1.35rem] tracking-[-0.02em]" set:html={word} />
    {
      !compact && (
        <span class="mt-1.5 text-[0.56rem] font-semibold uppercase tracking-[0.32em] opacity-70">{general.subtitluLogo}</span>
      )
    }
  </span>
</a>
