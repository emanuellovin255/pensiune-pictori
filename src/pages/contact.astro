---
import { Phone, MapPin, Clock, Plus, CircleCheck, Building, CreditCard } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MapEmbed from '../components/MapEmbed.astro';
import VoucherBand from '../components/VoucherBand.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { rooms } from '../data/rooms';
import { site, fullAddress, faq, mapsLink } from '../data/site';
import { photo } from '../lib/photos';
import { contact as c, general, em } from '../lib/continut';

const p = c.pagina;
const fm = c.formular;
const f = site.company;
---

<BaseLayout title={p.titluSeo} description={p.descriereSeo} image={photo(p.poza)}>
  <PageHero
    eyebrow={p.eticheta}
    crumb="Contact"
    title={em(p.titlu, 'text-brass-300')}
    subtitle={p.subtitlu}
    image={photo(p.poza)}
    alt={`Cameră la ${site.name}`}
  />

  <section class="bg-cream-100 py-20 md:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-12 lg:gap-12">
      <!-- FORMULAR -->
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{fm.eticheta}</p>
        <h2 class="display-md mt-6" data-split set:html={em(fm.titlu)} />
        <p class="mt-6 max-w-xl text-muted" data-reveal>{fm.text}</p>

        <form
          class="mt-12 grid gap-x-8 gap-y-9 sm:grid-cols-2"
          data-booking-form
          data-whatsapp={site.whatsappHref}
          data-name={site.name}
          data-success={fm.mesajSucces}
          novalidate
          data-reveal
        >
          <div class="field">
            <label for="f-sosire">Sosire *</label>
            <input id="f-sosire" name="sosire" type="date" required data-date-in />
          </div>
          <div class="field">
            <label for="f-plecare">Plecare *</label>
            <input id="f-plecare" name="plecare" type="date" required data-date-out />
          </div>
          <div class="field">
            <label for="f-adulti">Adulți *</label>
            <select id="f-adulti" name="adulti" required>
              {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n} selected={n === 2}>{n}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-copii">Copii</label>
            <select id="f-copii" name="copii">
              {[0, 1, 2, 3, 4].map((n) => <option value={n}>{n}</option>)}
            </select>
          </div>
          <div class="field sm:col-span-2">
            <label for="f-camera">Camera dorită</label>
            <select id="f-camera" name="camera">
              <option value="">Oricare / nu știu încă</option>
              {rooms.map((r) => <option value={r.slug}>{r.name} ({r.price} lei / noapte)</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-nume">Nume complet *</label>
            <input id="f-nume" name="nume" type="text" autocomplete="name" required placeholder="Numele tău" />
          </div>
          <div class="field">
            <label for="f-telefon">Număr de telefon *</label>
            <input id="f-telefon" name="telefon" type="tel" autocomplete="tel" required placeholder="07xx xxx xxx" />
          </div>
          <div class="field sm:col-span-2">
            <label for="f-email">Adresă de email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" placeholder="numele@exemplu.ro" />
          </div>
          <div class="field sm:col-span-2">
            <label for="f-mesaj">Mesaj</label>
            <textarea id="f-mesaj" name="mesaj" rows="4" placeholder="Ora sosirii, date pentru factură, animal de companie, alte cerințe…"></textarea>
          </div>

          <div class="sm:col-span-2">
            <p class="hidden rounded-2xl bg-clay-500/10 p-4 text-sm text-clay-500" data-form-error role="alert"></p>
            <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
              <button type="submit" class="btn btn-whatsapp">
                <WhatsAppIcon size={16} /> Trimite pe WhatsApp
              </button>
              <a href={site.phoneHref} class="btn btn-dark">
                <Phone size={15} /> Rezervă telefonic
              </a>
            </div>
            <div class="mt-6 hidden items-start gap-3 rounded-2xl bg-river-500/10 p-5 text-sm text-forest-900" data-form-success role="status">
              <CircleCheck size={20} stroke-width={1.5} class="mt-0.5 shrink-0 text-river-500" />
              <p>{fm.mesajSucces}</p>
            </div>
          </div>
        </form>
      </div>

      <!-- CONTACT -->
      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="space-y-4">
          <a href={site.phoneHref} class="group flex items-center gap-5 rounded-[1.5rem] bg-forest-900 p-6 text-cream-50 transition-colors hover:bg-forest-800" data-reveal>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brass-400 text-forest-900"><Phone size={20} stroke-width={1.6} /></span>
            <span>
              <span class="block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-cream-100/70">Telefon · Recepție non-stop</span>
              <span class="font-serif text-2xl">{site.phone}</span>
            </span>
          </a>
          <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-5 rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6 transition-colors hover:border-brass-500" data-reveal>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#25d366] text-white"><WhatsAppIcon size={22} /></span>
            <span>
              <span class="block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">WhatsApp</span>
              <span class="font-serif text-2xl">{site.whatsapp}</span>
            </span>
          </a>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="flex items-start gap-5 rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6 transition-colors hover:border-brass-500" data-reveal>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-forest-800 text-cream-50"><MapPin size={20} stroke-width={1.6} /></span>
            <span>
              <span class="block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Unde ne găsești</span>
              <span class="mt-1 block leading-snug">{fullAddress}</span>
            </span>
          </a>
          <div class="grid grid-cols-2 gap-4" data-reveal>
            <div class="rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6">
              <Clock size={20} stroke-width={1.5} class="text-brass-600" />
              <p class="mt-4 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Check-in</p>
              <p class="font-serif text-xl">{site.checkIn}</p>
              <p class="mt-3 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Check-out</p>
              <p class="font-serif text-xl">{site.checkOut}</p>
            </div>
            <div class="rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6">
              <CreditCard size={20} stroke-width={1.5} class="text-brass-600" />
              <p class="mt-4 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Plată</p>
              <p class="mt-1 text-sm leading-snug">Numerar, card și card de vacanță, la check-in.</p>
            </div>
          </div>
          <div class="flex items-start gap-5 rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6" data-reveal>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-forest-800 text-cream-50"><Building size={20} stroke-width={1.6} /></span>
            <span class="text-sm leading-relaxed">
              <span class="block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Date pentru factură</span>
              <span class="mt-1 block font-semibold">{f.denumire}</span>
              CUI {f.cui} · {f.registruComert}<br />
              {f.sediu}
            </span>
          </div>
          <div class="flex items-center justify-between gap-4 rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-6" data-reveal>
            <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted">Urmărește-ne</span>
            <SocialLinks class="text-forest-800" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <VoucherBand />

  <!-- FAQ -->
  <section id="intrebari" class="scroll-mt-20 bg-cream-100 py-24 md:py-36">
    <div class="container-x grid gap-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Întrebări frecvente" title={em('Ce ne *întreabă* oaspeții')} size="md" />
        <p class="mt-8 text-muted" data-reveal>{general.subsol.plata}</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <div class="border-t border-forest-900/10">
          {
            faq.map((q) => (
              <details class="group border-b border-forest-900/10" data-reveal>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-serif text-xl md:text-2xl">
                  {q.q}
                  <span class="faq-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-forest-900/15 transition-transform duration-500">
                    <Plus size={18} stroke-width={1.5} />
                  </span>
                </summary>
                <p class="pb-7 pr-14 text-muted">{q.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- HARTA -->
  <section class="bg-cream-100 pb-24 md:pb-36">
    <div class="container-x">
      <MapEmbed class="h-[520px]" />
    </div>
  </section>
</BaseLayout>

<script>
  import { wireDates } from '../scripts/dates';

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  if (form) {
    const WHATSAPP = form.dataset.whatsapp ?? '';
    const NUME = form.dataset.name ?? '';

    // Preia datele din bara de căutare de pe prima pagină sau din pagina camerei.
    const params = new URLSearchParams(window.location.search);
    const set = (name: string, value: string | null) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el && value) el.value = value;
    };
    set('sosire', params.get('sosire'));
    set('plecare', params.get('plecare'));
    set('adulti', params.get('adulti'));
    set('camera', params.get('camera'));
    wireDates(form);

    const errorBox = form.querySelector<HTMLElement>('[data-form-error]');
    const successBox = form.querySelector<HTMLElement>('[data-form-success]');

    const fmt = (iso: string) => {
      const [y, m, d] = iso.split('-');
      return `${d}.${m}.${y}`;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();

      const errors: string[] = [];
      if (!get('sosire') || !get('plecare')) errors.push('alege datele de sosire și plecare');
      else if (get('plecare') <= get('sosire')) errors.push('data plecării trebuie să fie după data sosirii');
      if (!get('nume')) errors.push('completează numele');
      if (!get('telefon')) errors.push('completează numărul de telefon');
      if (get('email') && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(get('email'))) errors.push('verifică adresa de email');

      if (errors.length && errorBox) {
        errorBox.textContent = `Te rugăm să ${errors.join(', ')}.`;
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      errorBox?.classList.add('hidden');

      const cameraSelect = form.elements.namedItem('camera') as HTMLSelectElement;
      const camera = get('camera') ? (cameraSelect.selectedOptions[0]?.textContent?.trim() ?? 'Oricare') : 'Oricare';
      const nights = Math.round((new Date(get('plecare')).getTime() - new Date(get('sosire')).getTime()) / 86400000);

      const message = [
        'Bună ziua,',
        '',
        `Aș dori o rezervare la ${NUME}:`,
        '',
        `Sosire: ${fmt(get('sosire'))}`,
        `Plecare: ${fmt(get('plecare'))} (${nights} ${nights === 1 ? 'noapte' : 'nopți'})`,
        `Adulți: ${get('adulti')}`,
        `Copii: ${get('copii') || '0'}`,
        `Camera: ${camera}`,
        '',
        `Nume: ${get('nume')}`,
        `Telefon: ${get('telefon')}`,
        get('email') ? `Email: ${get('email')}` : '',
        get('mesaj') ? `\nMesaj:\n${get('mesaj')}` : '',
        '',
        'Mulțumesc!',
      ]
        .filter((l, i, a) => l !== '' || a[i - 1] !== '')
        .join('\n');

      window.open(`${WHATSAPP}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
      successBox?.classList.remove('hidden');
      successBox?.classList.add('flex');
      successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
